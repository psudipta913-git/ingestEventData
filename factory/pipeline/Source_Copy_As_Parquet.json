{
	"name": "Source_Copy_As_Parquet",
	"properties": {
		"activities": [
			{
				"name": "Copy_Customers_Data",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "eventingestioncontainer//Customer.xlsx"
					},
					{
						"name": "Destination",
						"value": "sinkingestioncontainer/@{'Customer'}/@{concat('Customer_', \nformatDateTime(utcNow(),'yyyyMMdd'))}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Customer ID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Customer_id",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Customer Name",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Customer_name",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "email",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "email",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "phone",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "phone",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "address",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "address",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Segment",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Segment",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Country",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Country",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "City",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "City",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "State",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "State",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Postal Code",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Postal_code",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Region",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Region",
									"type": "String",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "Customers_DS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_DS",
						"type": "DatasetReference",
						"parameters": {
							"targetFolder": "Customer",
							"targetFile": {
								"value": "@concat('Customer_', \nformatDateTime(utcNow(),'yyyyMMdd'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy_Products_Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Copy_Customers_Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "eventingestioncontainer//Products.csv"
					},
					{
						"name": "Destination",
						"value": "sinkingestioncontainer/@{'Products'}/@{concat('Products_', \nformatDateTime(utcNow(),'yyyyMMdd'))}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": true,
					"logSettings": {
						"enableCopyActivityLog": true,
						"copyActivityLogSettings": {
							"logLevel": "Warning",
							"enableReliableLogging": false
						},
						"logLocationSettings": {
							"linkedServiceName": {
								"referenceName": "sourceblob_LD",
								"type": "LinkedServiceReference"
							},
							"path": "eventingestioncontainer"
						}
					},
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Product ID",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Product_ID",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Category",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Category",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Sub-Category",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Sub_Category",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Product Name",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Product_Name",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "State",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "State",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Price per product",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "Price_per_product",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "products_DS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_DS",
						"type": "DatasetReference",
						"parameters": {
							"targetFolder": "Products",
							"targetFile": {
								"value": "@concat('Products_', \nformatDateTime(utcNow(),'yyyyMMdd'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy_Orders_Data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Copy_Products_Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "eventingestioncontainer//@{concat('Orders_',\nformatDateTime(utcNow(),'yyyyMMdd')\n,'.json')}"
					},
					{
						"name": "Destination",
						"value": "sinkingestioncontainer/@{'Orders'}/@{concat('Orders_',  \nformatDateTime(utcNow(),'yyyyMMdd'))}"
					}
				],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['Row ID']"
								},
								"sink": {
									"name": "Row_ID"
								}
							},
							{
								"source": {
									"path": "$['Order ID']"
								},
								"sink": {
									"name": "Order_ID"
								}
							},
							{
								"source": {
									"path": "$['Order Date']"
								},
								"sink": {
									"name": "Order_Date"
								}
							},
							{
								"source": {
									"path": "$['Ship Date']"
								},
								"sink": {
									"name": "Ship_Date"
								}
							},
							{
								"source": {
									"path": "$['Ship Mode']"
								},
								"sink": {
									"name": "Ship_Mode"
								}
							},
							{
								"source": {
									"path": "$['Customer ID']"
								},
								"sink": {
									"name": "Customer_ID"
								}
							},
							{
								"source": {
									"path": "$['Product ID']"
								},
								"sink": {
									"name": "Product_ID"
								}
							},
							{
								"source": {
									"path": "$['Quantity']"
								},
								"sink": {
									"name": "Quantity"
								}
							},
							{
								"source": {
									"path": "$['Price']"
								},
								"sink": {
									"name": "Price"
								}
							},
							{
								"source": {
									"path": "$['Discount']"
								},
								"sink": {
									"name": "Discount"
								}
							},
							{
								"source": {
									"path": "$['Profit']"
								},
								"sink": {
									"name": "Profit"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "OrdersJson_DS",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "sink_DS",
						"type": "DatasetReference",
						"parameters": {
							"targetFolder": "Orders",
							"targetFile": {
								"value": "@concat('Orders_',  \nformatDateTime(utcNow(),'yyyyMMdd'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "CustomerFailure",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Copy_Customers_Data",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": "Copy Customers Filed",
					"errorCode": "500"
				}
			}
		],
		"annotations": []
	}
}